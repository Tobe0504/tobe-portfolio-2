# The site's public origin, without a trailing slash.
#
# Everything that cannot use a relative URL reads this: canonical links, Open
# Graph and Twitter image URLs, sitemap.xml and robots.txt. Set it in
# production. On Vercel the deployment falls back to the project's production
# domain automatically, and locally it falls back to http://localhost:3000, but
# neither survives a custom domain.
#
# Getting this wrong does not crash anything. It silently breaks link previews
# and points canonical tags at a host that does not exist.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
